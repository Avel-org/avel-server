DATABASE_URL=postgres://postgres:postgres@localhost:5432/avel_dev
PORT=8787
LOG_LEVEL=info

# Operator sign-in (Better Auth + GitHub OAuth App). Placeholders: the server
# refuses to start until these are real. Tests need none of them.
# At least 32 characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# The APP's origin, not this server's: the browser reaches /api/** through
# the web app's same-origin proxy (Vite in dev, Nitro in prod), so cookies
# stay first-party. The GitHub OAuth App's callback URL is
# <BETTER_AUTH_URL>/api/auth/callback/github
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=replace-with-oauth-app-client-id
GITHUB_CLIENT_SECRET=replace-with-oauth-app-client-secret
# Comma-separated GitHub numeric user ids (not logins) allowed to sign in.
# Find yours at https://api.github.com/users/<login> ("id").
AVEL_OPERATOR_GITHUB_IDS=
# Optional, comma-separated exact origins allowed credentialed CORS. For the
# Tauri builds: tauri://localhost and http://tauri.localhost, added once
# src-tauri exists. Empty means same-origin only. No wildcards.
AVEL_WEB_ORIGINS=

# DEV PREVIEW. Local only, read-only. Set to exactly 1 to let GET and HEAD
# under /api/* through with no session, so the UI can be viewed on seeded
# avel_dev data before the GitHub OAuth App exists. Every other method still
# needs a real session. The server refuses to start in preview unless
# NODE_ENV is not production, DATABASE_URL names a database ending in _dev,
# and BETTER_AUTH_URL's host is localhost or 127.0.0.1. Without the GitHub
# variables above, preview starts with sign-in switched off.
AVEL_DEV_PREVIEW=

# Template repositories (GET /api/templates). The GitHub organization that
# holds them and a read-only token for it. Without both, dev serves the
# fixture in src/lib/templates.ts and production lists every template as
# unreadable. The allowlist itself is TEMPLATE_REPOS in that file.
AVEL_TEMPLATE_OWNER=
AVEL_TEMPLATE_GITHUB_TOKEN=

# The runner's credential (module 6). The runner process sends it as
# Authorization: Bearer to write what it owns: token counts, halts, and the
# report for a halted or failed dispatch. Never put it in an agent's room.
# avl_run_ followed by at least 32 random characters. The server refuses to
# start without the avl_run_ prefix, or with fewer characters after it.
# Unset means no runner can call the API.
# AVEL_RUNNER_CREDENTIAL=

# Local clones that dispatch rooms are made from: templates/<slug> and
# repos/<owner>/<repo>. Unset means every dispatch start refuses source_unavailable.
# AVEL_SOURCES_DIR=
